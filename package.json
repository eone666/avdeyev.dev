{
  "name": "links",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "dev:site": "vite",
    "dev:cv": "forme dev cv/document.tsx",
    "build": "bun scripts/build.mjs",
    "build:site": "vite build --mode client && vite build",
    "build:cv": "forme build cv/document.tsx -o public/cv.pdf && bun scripts/enrich-cv.mjs",
    "start": "bun ./dist/index.js",
    "lint": "eslint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.7",
    "honox": "0.1.61",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@formepdf/cli": "^0.21.0",
    "@formepdf/core": "^0.21.0",
    "@formepdf/react": "^0.21.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@iconify-json/ri": "^1.2.10",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/three": "^0.185.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "lighthouse": "^13.4.1",
    "pdf-lib": "1.17.1",
    "react": "^19.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.1.4"
  }
}
