{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avdeyev-dev",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/"
    ]
  },
  "routes": [
    {
      "pattern": "avdeyev.dev",
      "custom_domain": true
    }
  ],
  "preview_urls": false
}
